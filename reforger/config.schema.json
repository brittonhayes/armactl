{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Arma Reforger Server Configuration",
  "description": "Configuration schema for Arma Reforger dedicated server (2025/2026 format)",
  "type": "object",
  "properties": {
    "bindAddress": {
      "type": "string",
      "description": "IP address to bind to (empty for auto, default: 0.0.0.0)"
    },
    "bindPort": {
      "type": "integer",
      "description": "UDP port for server socket (default: 2001)",
      "minimum": 1,
      "maximum": 65535
    },
    "publicAddress": {
      "type": "string",
      "description": "Public IP address (empty for auto-detection)"
    },
    "publicPort": {
      "type": "integer",
      "description": "Public UDP port (typically matches bindPort)",
      "minimum": 1,
      "maximum": 65535
    },
    "a2s": {
      "type": "object",
      "description": "Steam Query (A2S) protocol settings",
      "properties": {
        "address": {
          "type": "string",
          "description": "A2S bind address"
        },
        "port": {
          "type": "integer",
          "description": "A2S query port (default: 17777)",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "rcon": {
      "type": "object",
      "description": "Remote console (RCON) settings",
      "properties": {
        "address": {
          "type": "string",
          "description": "RCON bind address"
        },
        "port": {
          "type": "integer",
          "description": "RCON port (default: 19999)",
          "minimum": 1,
          "maximum": 65535
        },
        "password": {
          "type": "string",
          "description": "RCON password (minimum 3 characters, no spaces)",
          "minLength": 3
        },
        "maxClients": {
          "type": "integer",
          "description": "Maximum RCON clients (default: 16)",
          "minimum": 1
        },
        "permission": {
          "type": "string",
          "description": "RCON permission level",
          "enum": ["admin", "monitor"]
        },
        "blacklist": {
          "type": "array",
          "description": "Blacklisted IPs",
          "items": {
            "type": "string"
          }
        },
        "whitelist": {
          "type": "array",
          "description": "Whitelisted IPs",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "game": {
      "type": "object",
      "description": "Game settings",
      "properties": {
        "name": {
          "type": "string",
          "description": "Server name displayed in browser"
        },
        "password": {
          "type": "string",
          "description": "Server password (empty for public)"
        },
        "passwordAdmin": {
          "type": "string",
          "description": "Admin password"
        },
        "admins": {
          "type": "array",
          "description": "Array of admin Steam IDs",
          "items": {
            "type": "string"
          }
        },
        "scenarioId": {
          "type": "string",
          "description": "Mission/scenario ID"
        },
        "maxPlayers": {
          "type": "integer",
          "description": "Maximum players (1-128)",
          "minimum": 1,
          "maximum": 128
        },
        "visible": {
          "type": "boolean",
          "description": "Visible in server browser"
        },
        "crossPlatform": {
          "type": "boolean",
          "description": "Enable cross-platform play"
        },
        "supportedPlatforms": {
          "type": "array",
          "description": "Supported platforms",
          "items": {
            "type": "string",
            "enum": ["PLATFORM_PC", "PLATFORM_XBL", "PLATFORM_PSN"]
          }
        },
        "gameProperties": {
          "type": "object",
          "description": "Gameplay properties",
          "properties": {
            "serverMaxViewDistance": {
              "type": "integer",
              "description": "Maximum view distance in meters (500-10000)",
              "minimum": 500,
              "maximum": 10000
            },
            "serverMinGrassDistance": {
              "type": "integer",
              "description": "Minimum grass rendering distance",
              "minimum": 0
            },
            "networkViewDistance": {
              "type": "integer",
              "description": "Network streaming distance in meters (500-5000)",
              "minimum": 500,
              "maximum": 5000
            },
            "disableThirdPerson": {
              "type": "boolean",
              "description": "Disable third-person camera"
            },
            "fastValidation": {
              "type": "boolean",
              "description": "Enable fast validation (faster loading)"
            },
            "battlEye": {
              "type": "boolean",
              "description": "Enable BattlEye anti-cheat"
            },
            "VONDisableUI": {
              "type": "boolean",
              "description": "Disable VON UI"
            },
            "VONDisableDirectSpeechUI": {
              "type": "boolean",
              "description": "Disable direct speech UI"
            },
            "VONCanTransmitCrossFaction": {
              "type": "boolean",
              "description": "Allow cross-faction voice transmission"
            }
          }
        },
        "mods": {
          "type": "array",
          "description": "Server mods",
          "items": {
            "type": "object",
            "properties": {
              "modId": {
                "type": "string",
                "description": "Steam Workshop ID"
              },
              "name": {
                "type": "string",
                "description": "Mod name"
              },
              "version": {
                "type": "string",
                "description": "Mod version (optional)"
              },
              "required": {
                "type": "boolean",
                "description": "Required for clients"
              }
            },
            "required": ["modId"]
          }
        }
      }
    },
    "modsRequiredByDefault": {
      "type": "boolean",
      "description": "Require all mods by default"
    },
    "mods": {
      "type": "array",
      "description": "Top-level mods array (alternative to game.mods)",
      "items": {
        "type": "object",
        "properties": {
          "modId": {
            "type": "string",
            "description": "Steam Workshop ID"
          },
          "name": {
            "type": "string",
            "description": "Mod name"
          },
          "version": {
            "type": "string",
            "description": "Mod version"
          },
          "required": {
            "type": "boolean",
            "description": "Required for clients"
          }
        },
        "required": ["modId"]
      }
    },
    "operating": {
      "type": "object",
      "description": "Server operating settings",
      "properties": {
        "lobbyPlayerSynchronise": {
          "type": "boolean",
          "description": "Synchronize lobby players"
        },
        "disableCrashReporter": {
          "type": "boolean",
          "description": "Disable crash reporter"
        },
        "disableNavmeshStreaming": {
          "type": "array",
          "description": "Disabled navmesh streaming",
          "items": {
            "type": "string"
          }
        },
        "disableServerShutdown": {
          "type": "boolean",
          "description": "Prevent server shutdown"
        },
        "disableAI": {
          "type": "boolean",
          "description": "Disable AI entirely"
        },
        "playerSaveTime": {
          "type": "integer",
          "description": "Player save interval in seconds",
          "minimum": 0
        },
        "aiLimit": {
          "type": "integer",
          "description": "Maximum AI count",
          "minimum": 0
        },
        "slotReservationTimeout": {
          "type": "integer",
          "description": "Slot reservation timeout in seconds",
          "minimum": 0
        },
        "joinQueue": {
          "type": "object",
          "properties": {
            "maxSize": {
              "type": "integer",
              "description": "Maximum queue size",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "required": ["bindPort", "publicPort"]
}
